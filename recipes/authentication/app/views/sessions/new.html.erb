<div class="w-full sm:mx-auto sm:max-w-sm">
  <h1 class="text-center text-2xl/9 font-bold tracking-tight text-gray-900 dark:text-white"><%= t(".heading") %></h1>

  <% if alert = flash[:alert] %>
    <div id="alert" class="mt-6 rounded-md bg-red-50 p-4 dark:bg-red-500/15 dark:outline dark:outline-red-500/25">
      <div class="flex">
        <div class="shrink-0"><%= lucide_icon "circle-x", class: "size-5 text-red-400", "aria-hidden": "true" %></div>
        <p class="ml-3 text-sm font-medium text-red-800 dark:text-red-200"><%= alert %></p>
      </div>
    </div>
  <% end %>

  <% if notice = flash[:notice] %>
    <div id="notice" class="mt-6 rounded-md bg-green-50 p-4 dark:bg-green-500/10 dark:outline dark:outline-green-500/20">
      <div class="flex">
        <div class="shrink-0"><%= lucide_icon "circle-check", class: "size-5 text-green-400", "aria-hidden": "true" %></div>
        <p class="ml-3 text-sm font-medium text-green-800 dark:text-green-200"><%= notice %></p>
      </div>
    </div>
  <% end %>

  <%= form_with url: session_url, class: "mt-10 space-y-6" do |form| %>
    <div>
      <%= form.label :email_address, t(".email_address"), class: "block text-sm/6 font-medium text-gray-900 dark:text-gray-100" %>
      <div class="mt-2">
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-indigo-500" %>
      </div>
    </div>

    <div>
      <div class="flex items-center justify-between">
        <%= form.label :password, t(".password"), class: "block text-sm/6 font-medium text-gray-900 dark:text-gray-100" %>
        <div class="text-sm">
          <%= link_to t(".forgot_password"), new_password_path, class: "font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300" %>
        </div>
      </div>
      <div class="mt-2">
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6 dark:bg-white/5 dark:text-white dark:outline-white/10 dark:placeholder:text-gray-500 dark:focus:outline-indigo-500" %>
      </div>
    </div>

    <%= form.submit t(".submit"), class: "flex w-full cursor-pointer justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:bg-indigo-500 dark:shadow-none dark:hover:bg-indigo-400 dark:focus-visible:outline-indigo-500" %>
  <% end %>
</div>
